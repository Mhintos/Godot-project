; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Front Desk"
run/main_scene="uid://vegcmgex6h1c"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/image="uid://cjns48nxpcljx"
config/icon="uid://caua4wf67rwhm"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://bel0qcahglanw"

[file_customization]

folder_colors={
"res://assets/": "pink",
"res://assets/Characters/": "teal",
"res://assets/documents/": "pink",
"res://assets/ui/": "red",
"res://scene/": "orange",
"res://scene/Character/": "teal",
"res://scene/Documents/": "green",
"res://scene/Documents/Full Documents Forged/": "purple",
"res://scene/Documents/Full Documents/": "purple",
"res://scene/Documents/Mini Documents Forged/": "yellow",
"res://scene/Documents/Mini Documents/": "yellow",
"res://script/": "red",
"res://sfx/": "gray"
}

[input]

drag={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
